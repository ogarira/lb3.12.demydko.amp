        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    A([Start main()]) --&gt; B[userTotalScore = 0, compTotalScore = 0&lt;br&gt;level1Lives = 5, level1Passed = true&lt;br&gt;round = 1]\n    B --&gt; C{round &lt;= 3}\n    \n    %% РІВЕНЬ 1: Основний цикл раунду\n    C -- Yes --&gt; D[targetNumber = 1 + rand() % 10&lt;br&gt;lives = level1Lives]\n    D --&gt; E{lives &gt; 0}\n    \n    E -- Yes --&gt; F[/cin &gt;&gt; guess/]\n    F --&gt; G{guess == targetNumber}\n    \n    %% Гілка виграшу раунду\n    G -- Yes --&gt; H[roundScore = lives * 5&lt;br&gt;userTotalScore += roundScore]\n    \n    %% Гілка програшу спроби\n    G -- No --&gt; I[lives--]\n    I --&gt; J{lives &gt; 0}\n    \n    %% Гілка вичерпання життів (Програш раунду)\n    J -- No --&gt; K[compRoundScore = level1Lives * 5&lt;br&gt;compTotalScore += compRoundScore&lt;br&gt;level1Passed = false]\n    \n    %% Запит на підказку\n    J -- Yes --&gt; L[/cin &gt;&gt; choice/]\n    L --&gt; M{choice == &#39;y&#39; || choice == &#39;Y&#39;}\n    \n    %% Гілки підказок розходяться в різні сторони\n    M -- Yes --&gt; N[lives--]\n    N --&gt; O{guess &lt; targetNumber}\n    O -- Yes --&gt; P[/cout &lt;&lt; \&quot;BIGGER\&quot;/]\n    O -- No --&gt; Q[/cout &lt;&lt; \&quot;SMALLER\&quot;/]\n    \n    %% Повернення після підказки або відмови від неї на нову спробу\n    P --&gt; E\n    Q --&gt; E\n    M -- No --&gt; E\n    \n    %% Зведення виграшу/програшу в підсумок раунду\n    H --&gt; R[/cout &lt;&lt; userTotalScore &lt;&lt; compTotalScore/]\n    K --&gt; R\n    R --&gt; S[round++]\n    S --&gt; C\n    \n    %% РІВЕНЬ 2 та Фінал\n    C -- No --&gt; T{level1Passed == true}\n    \n    T -- Yes --&gt; U[/cin &gt;&gt; continueChoice/]\n    U --&gt; V{continueChoice == &#39;y&#39; || continueChoice == &#39;Y&#39;}\n    V -- Yes --&gt; W[РІВЕНЬ 2&lt;br&gt;round &lt;= 2, 10..100]\n    \n    %% Зведення до фінального підсумку\n    W --&gt; X[/cout &lt;&lt; Final Scores/]\n    V -- No --&gt; X\n    T -- No --&gt; X\n    \n    %% Фінальна перевірка переможця\n    X --&gt; Y{userTotalScore &gt; compTotalScore}\n    Y -- Yes --&gt; Z1[/cout &lt;&lt; \&quot;Player Wins!\&quot;/]\n    Y -- No --&gt; Z2{userTotalScore &lt; compTotalScore}\n    Z2 -- Yes --&gt; Z3[/cout &lt;&lt; \&quot;Computer Wins!\&quot;/]\n    Z2 -- No --&gt; Z4[/cout &lt;&lt; \&quot;Draw!\&quot;/]\n    \n    Z1 --&gt; END([End main()])\n    Z3 --&gt; END\n    Z4 --&gt; END&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="YR-0kbJIoeAPQJ7z6Agd-2">
